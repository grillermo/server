#!/usr/bin/env ruby
# frozen_string_literal: true
#
# The published application routes (hostname -> local service) of every
# dashboard-managed Cloudflare tunnel on the account, managed from routes.yml
# instead of the Zero Trust dashboard.
#
#   ./routes pull                   write routes.yml from what Cloudflare has now
#   ./routes sync [--dry-run]       make Cloudflare match routes.yml
#   ./routes create HOST URL [--tunnel NAME] [--caddy PORT]
#   ./routes modify HOST URL [--tunnel NAME] [--caddy PORT | --no-caddy]
#   ./routes delete|remove HOST
#   ./routes list
#
# create, modify and delete edit routes.yml and then sync; all three take
# --dry-run. Editing routes.yml by hand and running ./routes sync does the
# same thing. create uses the tunnel this machine runs unless --tunnel says
# otherwise; modify --tunnel moves a route to another tunnel.
#
# sync is a full reconcile of every tunnel in routes.yml, in this order:
#   1. Caddy: a route with `caddy:` (allowed only on the tunnel marked
#      `caddy: true`) gets a generated block in the Caddyfile (Caddy listens
#      on the service port and proxies to the `caddy:` URL), then ./reload.
#      Only blocks between `# routes:begin/end` markers are touched;
#      hand-written sites are never edited. Caddy changes have to be synced
#      on the machine that runs that tunnel.
#   2. Each tunnel's ingress rules (PUT .../configurations; cloudflared picks
#      them up live, no restart).
#   3. DNS: a proxied CNAME HOST -> <tunnel-id>.cfargotunnel.com per route.
#      A CNAME to another tunnel in routes.yml is repointed; a CNAME to one
#      of them whose host has no route is deleted. A host with any other
#      record is an error, never clobbered.
#
# URL may be a bare port: `./routes create x.grillermo.com 8081` means
# http://localhost:8081. With --caddy 8080, Cloudflare points at :8080 and the
# generated Caddy block proxies :8080 to the URL.
#
# The API token comes from CLOUDFLARE_API_TOKEN, or from that key in .env next
# to this script (gitignored). It needs Account / Cloudflare Tunnel / Edit,
# Zone / Zone / Read and Zone / DNS / Edit on every zone that has a route.

require "json"
require "net/http"
require "optparse"
require "uri"
require "yaml"

# The Caddyfile and routes.yml are UTF-8, but a non-interactive ssh session
# on Linux has no locale, and Ruby then reads files as US-ASCII.
Encoding.default_external = Encoding::UTF_8

module Routes
  HERE = File.expand_path(__dir__)
  REGISTRY = ENV.fetch("ROUTES_FILE", File.join(HERE, "routes.yml"))
  CADDYFILE = ENV.fetch("ROUTES_CADDYFILE", File.join(HERE, "Caddyfile"))
  RELOAD = ENV.fetch("ROUTES_RELOAD", File.join(HERE, "reload"))
  DEFAULT_CATCH_ALL = "http_status:404"

  class Error < StandardError; end

  # Cloudflare v4 REST API, just the calls this script makes.
  class Api
    BASE = "https://api.cloudflare.com/client/v4"

    def initialize(token)
      @token = token
    end

    def accounts
      paginate("/accounts")
    end

    def tunnels(account_id)
      paginate("/accounts/#{account_id}/cfd_tunnel", "is_deleted" => "false")
    end

    # nil when the tunnel has never been given a configuration.
    def tunnel_config(account_id, tunnel_id)
      result = request(:get, "/accounts/#{account_id}/cfd_tunnel/#{tunnel_id}/configurations")["result"]
      result && result["config"]
    end

    def put_tunnel_config(account_id, tunnel_id, config)
      request(:put, "/accounts/#{account_id}/cfd_tunnel/#{tunnel_id}/configurations", "config" => config)
    end

    def zones(account_id)
      paginate("/zones", account_id ? { "account.id" => account_id } : {})
    end

    def dns_records(zone_id)
      paginate("/zones/#{zone_id}/dns_records")
    end

    def create_dns_record(zone_id, record)
      request(:post, "/zones/#{zone_id}/dns_records", record)
    end

    def update_dns_record(zone_id, record_id, changes)
      request(:patch, "/zones/#{zone_id}/dns_records/#{record_id}", changes)
    end

    def delete_dns_record(zone_id, record_id)
      request(:delete, "/zones/#{zone_id}/dns_records/#{record_id}")
    end

    private

    def paginate(path, query = {})
      results = []
      page = 1
      loop do
        data = request(:get, path, nil, query.merge("page" => page, "per_page" => 50))
        results.concat(data["result"] || [])
        info = data["result_info"] || {}
        break if info["total_pages"].nil? || page >= info["total_pages"].to_i

        page += 1
      end
      results
    end

    def request(method, path, body = nil, query = {})
      uri = URI(BASE + path)
      uri.query = URI.encode_www_form(query) unless query.empty?
      req = Net::HTTP.const_get(method.to_s.capitalize).new(uri)
      req["Authorization"] = "Bearer #{@token}"
      if body
        req["Content-Type"] = "application/json"
        req.body = JSON.generate(body)
      end
      res = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |http| http.request(req) }
      data = begin
        JSON.parse(res.body.to_s)
      rescue JSON::ParserError
        raise Error, "#{method.upcase} #{path}: HTTP #{res.code}, not JSON: #{res.body.to_s[0, 200]}"
      end
      unless data["success"]
        errors = (data["errors"] || []).map { |e| "#{e['code']} #{e['message']}" }.join("; ")
        raise Error, "#{method.upcase} #{path} failed (HTTP #{res.code}): #{errors}"
      end
      data
    end
  end

  # One cloudflared tunnel and its routes (host => route hash, in ingress order).
  Tunnel = Struct.new(:name, :id, :caddy, :catch_all, :routes) do
    def target
      "#{id}.cfargotunnel.com"
    end

    def ingress
      rules = routes.map do |host, route|
        rule = { "hostname" => host, "service" => route["service"] }
        rule["path"] = route["path"] if route["path"]
        rule["originRequest"] = route["originRequest"] if route["originRequest"]
        rule
      end
      rules << { "service" => catch_all }
    end
  end

  # routes.yml: every tunnel's published application routes, one per hostname.
  class Registry
    ROUTE_KEYS = %w[service caddy path note originRequest].freeze
    TUNNEL_KEYS = %w[id caddy catch_all routes].freeze
    HEADER = <<~YAML
      # Published application routes of the account's Cloudflare tunnels.
      # Edit this file (or use ./routes create|modify|delete), then ./routes sync.
      #
      #   tunnels:
      #     NAME:
      #       id: TUNNEL-ID
      #       caddy: true                      only on the tunnel whose machine runs ./Caddyfile
      #       routes:
      #         host: http://localhost:3000        Cloudflare -> localhost:3000
      #         host:
      #           service: http://localhost:8080   Cloudflare -> localhost:8080 ...
      #           caddy: http://localhost:8081     ... a generated Caddy block -> localhost:8081
      #           note: anything                   kept across rewrites (comments are not)
      #
      # Optional per route: path (regex), originRequest (cloudflared options).
      # A hostname belongs to one tunnel. This file is rewritten by
      # ./routes pull/create/modify/delete.
    YAML

    attr_accessor :account_id, :tunnels

    def initialize(account_id:, tunnels: {})
      @account_id = account_id
      @tunnels = tunnels
    end

    def self.load(path)
      raise Error, "#{path} not found; run ./routes pull first" unless File.exist?(path)

      data = YAML.safe_load(File.read(path)) || {}
      raise Error, "#{path}: expected a mapping at the top level" unless data.is_a?(Hash)
      raise Error, "#{path} is in the old one-tunnel format; run ./routes pull" if data.key?("tunnel_id")

      tunnels = {}
      (data["tunnels"] || {}).each do |name, value|
        name = name.to_s
        raise Error, "#{path}: tunnel #{name} must be a mapping with an id" unless value.is_a?(Hash) && value["id"]

        unknown = value.keys - TUNNEL_KEYS
        raise Error, "#{path}: tunnel #{name} has unknown keys: #{unknown.join(', ')}" unless unknown.empty?

        tunnels[name] = Tunnel.new(name, value["id"].to_s, value["caddy"] == true,
                                   value["catch_all"] || DEFAULT_CATCH_ALL, load_routes(path, name, value["routes"]))
      end
      registry = new(account_id: data["account_id"].to_s, tunnels: tunnels)
      raise Error, "#{path}: account_id is required" if registry.account_id.empty?

      registry.validate!
      registry
    end

    def self.load_routes(path, tunnel, value)
      routes = {}
      (value || {}).each do |host, route|
        host = Routes.normalize_host(host.to_s)
        route = { "service" => route } if route.is_a?(String)
        raise Error, "#{path}: #{host} (#{tunnel}) needs a service URL" unless route.is_a?(Hash) && route["service"].is_a?(String)

        unknown = route.keys - ROUTE_KEYS
        raise Error, "#{path}: #{host} has unknown keys: #{unknown.join(', ')}" unless unknown.empty?
        raise Error, "#{path}: #{host} is listed twice" if routes.key?(host)

        routes[host] = route
      end
      routes
    end

    # Routes from a tunnel's remote config. Raises on shapes this file can't
    # express (a hostname used by two rules, a hostless rule before the end).
    def self.routes_from_ingress(ingress)
      rules = (ingress || []).dup
      catch_all = DEFAULT_CATCH_ALL
      catch_all = rules.pop["service"] if rules.last && rules.last["hostname"].to_s.empty? && rules.last["path"].to_s.empty?
      routes = {}
      rules.each do |rule|
        host = rule["hostname"].to_s
        raise Error, "the tunnel has a rule with no hostname before the last one: #{rule.to_json}" if host.empty?
        raise Error, "#{host} appears in more than one ingress rule; routes.yml supports one rule per host" if routes.key?(host)

        route = { "service" => rule["service"] }
        route["path"] = rule["path"] unless rule["path"].to_s.empty?
        route["originRequest"] = rule["originRequest"] if rule["originRequest"].is_a?(Hash) && !rule["originRequest"].empty?
        routes[host] = route
      end
      [routes, catch_all]
    end

    # The port Caddy listens on for a route with `caddy:` (= its service port).
    def self.caddy_port(host, route)
      match = %r{\Ahttp://localhost:(\d+)/?\z}.match(route["service"])
      raise Error, "#{host}: with caddy:, service must be http://localhost:PORT (the port Caddy listens on)" unless match

      match[1].to_i
    end

    def validate!
      caddy_tunnels = tunnels.values.select(&:caddy)
      raise Error, "only one tunnel can have caddy: true (#{caddy_tunnels.map(&:name).join(', ')})" if caddy_tunnels.length > 1

      seen = {}
      tunnels.each_value do |tunnel|
        tunnel.routes.each do |host, route|
          raise Error, "#{host} is on both #{seen[host]} and #{tunnel.name}; a hostname belongs to one tunnel" if seen[host]

          seen[host] = tunnel.name
          next unless route["caddy"]
          raise Error, "#{host}: caddy: needs the tunnel marked caddy: true, and #{tunnel.name} is not" unless tunnel.caddy

          Registry.caddy_port(host, route)
        end
      end
    end

    def owner(host)
      tunnels.each_value.find { |tunnel| tunnel.routes.key?(host) }
    end

    def tunnel(name_or_id)
      tunnels.each_value.find { |tunnel| [tunnel.name, tunnel.id].include?(name_or_id) } or
        raise Error, "no tunnel #{name_or_id.inspect} in routes.yml (#{tunnels.keys.join(', ')})"
    end

    def caddy_tunnel
      tunnels.each_value.find(&:caddy)
    end

    def save(path)
      File.write(path, to_yaml)
    end

    def to_yaml
      lines = [HEADER, "account_id: #{scalar(account_id)}", "tunnels:"]
      tunnels.each_value do |tunnel|
        lines << "  #{scalar(tunnel.name)}:"
        lines << "    id: #{scalar(tunnel.id)}"
        lines << "    caddy: true" if tunnel.caddy
        lines << "    catch_all: #{scalar(tunnel.catch_all)}" unless tunnel.catch_all == DEFAULT_CATCH_ALL
        if tunnel.routes.empty?
          lines << "    routes: {}"
          next
        end
        lines << "    routes:"
        tunnel.routes.each { |host, route| lines.concat(route_lines(host, route)) }
      end
      "#{lines.join("\n")}\n"
    end

    private

    def route_lines(host, route)
      return ["      #{scalar(host)}: #{scalar(route['service'])}"] if route.keys == ["service"]

      lines = ["      #{scalar(host)}:"]
      %w[service caddy path note].each { |key| lines << "        #{key}: #{scalar(route[key])}" if route[key] }
      if route["originRequest"]
        dumped = YAML.dump("originRequest" => route["originRequest"]).sub(/\A---\n/, "")
        dumped.each_line { |line| lines << "        #{line.chomp}" }
      end
      lines
    end

    def scalar(value)
      string = value.to_s
      plain = string.match?(%r{\A[A-Za-z0-9][\w.:/@+-]*\z}) && !string.match?(/\A(true|false|yes|no|on|off|null|~|[\d.]+)\z/i)
      plain ? string : string.to_json
    end
  end

  # The generated Caddy blocks inside the Caddyfile, between marker comments.
  class Caddyfile
    BLOCK = /^# routes:begin (\S+)\n.*?^# routes:end \1\n/m.freeze

    attr_reader :path, :text, :original

    def initialize(path)
      @path = path
      @original = File.exist?(path) ? File.read(path) : ""
      @text = @original.dup
    end

    # host => { port:, upstream: }
    def managed
      @text.to_enum(:scan, BLOCK).map { Regexp.last_match }.each_with_object({}) do |match, out|
        block = match[0]
        out[match[1]] = {
          port: block[/^:(\d+) \{/, 1].to_i,
          upstream: block[/^\s*reverse_proxy (\S+)/, 1],
        }
      end
    end

    # Some other site in the Caddyfile already listens on this port.
    def port_taken?(port, host)
      without_own = @text.gsub(BLOCK) { |block| block.start_with?("# routes:begin #{host}\n") ? "" : block }
      without_own.match?(/^\S*:#{port}[\s,{]/)
    end

    def set(host, port, upstream)
      block = <<~CADDY
        # routes:begin #{host}
        # Generated by ./routes from routes.yml; change it there, not here.
        :#{port} {
        \treverse_proxy #{upstream}
        }
        # routes:end #{host}
      CADDY
      if managed.key?(host)
        @text = @text.sub(block_for(host), block)
      else
        @text = @text.sub(/\n*\z/, "\n\n") unless @text.empty?
        @text += block
      end
    end

    def remove(host)
      @text = @text.sub(/\n*#{Regexp.escape(block_for(host))}/) { "\n" }
      @text = @text.sub(/\n+\z/, "\n")
    end

    def changed?
      @text != @original
    end

    def save
      File.write(@path, @text)
    end

    def restore
      File.write(@path, @original)
    end

    private

    def block_for(host)
      @text.to_enum(:scan, BLOCK).map { Regexp.last_match }.find { |m| m[1] == host }[0]
    end
  end

  # Works out what has to change to make Cloudflare and the Caddyfile match a
  # registry, prints it, and applies it.
  class Sync
    Plan = Struct.new(:caddy, :configs, :dns_create, :dns_update, :dns_delete, :lines) do
      def empty?
        lines.empty?
      end
    end

    # local_tunnel_id: the tunnel cloudflared runs on this machine, if any.
    def initialize(registry:, api:, caddyfile:, reload:, local_tunnel_id:, out: $stdout)
      @registry = registry
      @api = api
      @caddyfile = caddyfile
      @reload = reload
      @local_tunnel_id = local_tunnel_id
      @out = out
    end

    # Raises before anything changes if the registry can't be applied.
    def plan
      @registry.validate!
      lines = []
      caddy = plan_caddy(lines)
      configs = plan_ingress(lines)
      dns_create, dns_update, dns_delete = plan_dns(lines)
      Plan.new(caddy, configs, dns_create, dns_update, dns_delete, lines)
    end

    def apply(plan)
      if plan.caddy.changed?
        plan.caddy.save
        unless @reload.call
          plan.caddy.restore
          raise Error, "./reload failed; the Caddyfile was put back and nothing on Cloudflare changed"
        end
      end
      plan.configs.each { |tunnel, config| @api.put_tunnel_config(@registry.account_id, tunnel.id, config) }
      plan.dns_create.each { |zone_id, record| @api.create_dns_record(zone_id, record) }
      plan.dns_update.each { |zone_id, record, changes| @api.update_dns_record(zone_id, record["id"], changes) }
      plan.dns_delete.each { |zone_id, record| @api.delete_dns_record(zone_id, record["id"]) }
    end

    def print(plan)
      if plan.empty?
        @out.puts "Everything already matches routes.yml."
      else
        plan.lines.each { |line| @out.puts line }
      end
    end

    private

    def plan_caddy(lines)
      caddy = Caddyfile.new(@caddyfile)
      current = caddy.managed
      owner = @registry.caddy_tunnel
      wanted = owner ? owner.routes.select { |_, route| route["caddy"] } : {}
      wanted.each do |host, route|
        port = Registry.caddy_port(host, route)
        have = current[host]
        next if have && have[:port] == port && have[:upstream] == route["caddy"]
        raise Error, "#{host}: port :#{port} is already used by another site in #{@caddyfile}" if caddy.port_taken?(port, host)

        caddy.set(host, port, route["caddy"])
        lines << "#{have ? '~' : '+'} caddy  :#{port} -> #{route['caddy']}  (#{host})"
      end
      (current.keys - wanted.keys).each do |host|
        caddy.remove(host)
        lines << "- caddy  :#{current[host][:port]} -> #{current[host][:upstream]}  (#{host})"
      end
      if caddy.changed? && (owner.nil? || owner.id != @local_tunnel_id)
        where = owner ? "the machine that runs the #{owner.name} tunnel" : "the machine whose Caddy uses #{@caddyfile}"
        raise Error, "this changes the Caddyfile, so run it on #{where}:\n#{lines.join("\n")}"
      end
      caddy
    end

    # [[tunnel, new config]] for every tunnel whose remote ingress differs.
    def plan_ingress(lines)
      @registry.tunnels.each_value.each_with_object([]) do |tunnel, configs|
        remote_config = @api.tunnel_config(@registry.account_id, tunnel.id) || {}
        remote = normalize(remote_config["ingress"] || [])
        desired = tunnel.ingress
        next if normalize(desired) == remote

        before = lines.length
        remote_by_host = by_host(remote)
        by_host(normalize(desired)).each do |host, rule|
          old = remote_by_host.delete(host)
          if old.nil?
            lines << "+ route  #{host} -> #{describe(rule)}  (#{tunnel.name})"
          elsif old != rule
            lines << "~ route  #{host}: #{describe(old)} => #{describe(rule)}  (#{tunnel.name})"
          end
        end
        remote_by_host.each { |host, rule| lines << "- route  #{host} -> #{describe(rule)}  (#{tunnel.name})" }
        lines << "~ route  rule order or catch-all  (#{tunnel.name})" if lines.length == before
        configs << [tunnel, remote_config.merge("ingress" => desired)]
      end
    end

    def plan_dns(lines)
      targets = @registry.tunnels.each_value.each_with_object({}) { |tunnel, out| out[tunnel.target] = tunnel }
      zones = @api.zones(@registry.account_id)
      records = zones.each_with_object({}) { |zone, out| out[zone["id"]] = @api.dns_records(zone["id"]) }
      creates = []
      updates = []
      errors = []
      routed = {}
      @registry.tunnels.each_value do |tunnel|
        tunnel.routes.each_key do |host|
          routed[host] = true
          # The route still syncs; only its DNS is out of reach.
          zone = zone_for(host, zones)
          unless zone
            @out.puts "! dns    #{host}: skipped, the token sees no zone for it (#{zones.map { |z| z['name'] }.join(', ')})"
            next
          end
          existing = records[zone["id"]].select { |record| record["name"] == host }
          next if existing.any? { |record| record["type"] == "CNAME" && record["content"] == tunnel.target }

          ours = existing.select { |record| record["type"] == "CNAME" && targets.key?(record["content"]) }
          if existing.empty?
            creates << [zone["id"], { "type" => "CNAME", "name" => host, "content" => tunnel.target, "proxied" => true, "comment" => "./routes" }]
            lines << "+ dns    #{host} CNAME #{tunnel.name}"
          elsif ours.length == 1 && existing.length == 1
            updates << [zone["id"], ours.first, { "content" => tunnel.target, "proxied" => true }]
            lines << "~ dns    #{host} CNAME #{targets[ours.first['content']].name} => #{tunnel.name}"
          else
            shown = existing.map { |record| "#{record['type']} #{record['content']}" }.join(", ")
            errors << "#{host} already has DNS #{shown}; delete it in the dashboard if this route should replace it"
          end
        end
      end
      raise Error, errors.join("\n") unless errors.empty?

      deletes = []
      records.each do |zone_id, zone_records|
        zone_records.each do |record|
          next unless record["type"] == "CNAME" && targets.key?(record["content"]) && !routed[record["name"]]

          deletes << [zone_id, record]
          lines << "- dns    #{record['name']} CNAME #{targets[record['content']].name}"
        end
      end
      [creates, updates, deletes]
    end

    def zone_for(host, zones)
      zones.select { |zone| host == zone["name"] || host.end_with?(".#{zone['name']}") }.max_by { |zone| zone["name"].length }
    end

    def normalize(rules)
      rules.map do |rule|
        out = { "service" => rule["service"] }
        out["hostname"] = rule["hostname"] unless rule["hostname"].to_s.empty?
        out["path"] = rule["path"] unless rule["path"].to_s.empty?
        out["originRequest"] = rule["originRequest"] if rule["originRequest"].is_a?(Hash) && !rule["originRequest"].empty?
        out
      end
    end

    def by_host(rules)
      rules.each_with_object({}) { |rule, out| out[rule["hostname"]] = rule if rule["hostname"] }
    end

    def describe(rule)
      [rule["service"], rule["path"] && "path #{rule['path']}", rule["originRequest"] && "originRequest #{rule['originRequest'].to_json}"].compact.join(", ")
    end
  end

  def self.normalize_host(host)
    host = host.strip.downcase.sub(/\.\z/, "")
    raise Error, "#{host.inspect} is not a hostname" unless host.match?(/\A(\*\.)?([a-z0-9_-]+\.)+[a-z]{2,}\z/)

    host
  end

  def self.normalize_url(url)
    return "http://localhost:#{url}" if url.match?(/\A\d+\z/)
    return "http://#{url}" if url.match?(/\Alocalhost:\d+\z/)
    raise Error, "#{url.inspect} is not a URL (try http://localhost:8081 or just 8081)" unless url.match?(/\A[a-z_]+:/)

    url
  end

  class CLI
    USAGE = File.read(__FILE__)[/^#   \.\/routes.*?(?=^#\n)/m].gsub(/^# ?/, "")

    def initialize(argv, api: nil, out: $stdout, reload: nil)
      @argv = argv.dup
      @api = api
      @out = out
      @reload = reload || -> { system(RELOAD) }
    end

    def run
      opts = { dry_run: false, caddy: nil, no_caddy: false, tunnel: nil }
      parser = OptionParser.new do |o|
        o.banner = USAGE
        o.on("--dry-run") { opts[:dry_run] = true }
        o.on("--caddy PORT", Integer) { |port| opts[:caddy] = port }
        o.on("--no-caddy") { opts[:no_caddy] = true }
        o.on("--tunnel NAME") { |name| opts[:tunnel] = name }
      end
      args = parser.parse(@argv)
      command = args.shift
      case command
      when "pull" then pull
      when "sync" then sync(Registry.load(REGISTRY), dry_run: opts[:dry_run])
      when "list" then list
      when "create" then create(*want(args, 2), **opts.reject { |key, _| key == :no_caddy })
      when "modify" then modify(*want(args, 2), **opts)
      when "delete", "remove" then delete(*want(args, 1), dry_run: opts[:dry_run])
      else
        @out.puts USAGE
        return command.nil? || command == "help" ? 0 : 2
      end
      0
    end

    private

    def want(args, count)
      raise Error, "expected #{count} argument(s), got #{args.length}\n\n#{USAGE}" unless args.length == count

      args
    end

    def api
      @api ||= Api.new(token)
    end

    def token
      return ENV["CLOUDFLARE_API_TOKEN"] if ENV["CLOUDFLARE_API_TOKEN"].to_s != ""

      env = File.join(HERE, ".env")
      line = File.exist?(env) && File.readlines(env).find { |l| l.start_with?("CLOUDFLARE_API_TOKEN=") }
      raise Error, "set CLOUDFLARE_API_TOKEN, or put CLOUDFLARE_API_TOKEN=... in #{env}" unless line

      line.split("=", 2)[1].strip.delete('"\'')
    end

    def pull
      # Some tokens get an empty /accounts; their zones still name the account.
      accounts = api.accounts
      accounts = api.zones(nil).map { |zone| zone["account"] }.uniq { |account| account["id"] } if accounts.empty?
      raise Error, "the token can't see any account or zone" if accounts.empty?
      raise Error, "the token sees #{accounts.length} accounts; routes.yml handles one" if accounts.length > 1

      account = accounts.first
      tunnels = {}
      api.tunnels(account["id"]).each do |remote|
        if remote["config_src"] != "cloudflare"
          @out.puts "! #{remote['name']} is a locally-managed tunnel (config.yml on its machine); skipped"
          next
        end
        routes, catch_all = Registry.routes_from_ingress((api.tunnel_config(account["id"], remote["id"]) || {})["ingress"])
        tunnels[remote["name"]] = Tunnel.new(remote["name"], remote["id"], false, catch_all, routes)
      end
      registry = Registry.new(account_id: account["id"], tunnels: tunnels)
      settle_shared_hosts(registry)
      keep_local_fields(registry)
      registry.validate!
      registry.save(REGISTRY)
      counts = tunnels.each_value.map { |tunnel| "#{tunnel.name} #{tunnel.routes.length}" }.join(", ")
      @out.puts "Wrote #{REGISTRY}: routes per tunnel: #{counts}."
    end

    # A hostname in several tunnels' ingress can only be served by the one its
    # CNAME points at; the others' rules are stale, and the next sync drops them.
    def settle_shared_hosts(registry)
      owners = Hash.new { |hash, key| hash[key] = [] }
      registry.tunnels.each_value { |tunnel| tunnel.routes.each_key { |host| owners[host] << tunnel } }
      shared = owners.select { |_, tunnels| tunnels.length > 1 }
      return if shared.empty?

      cnames = {}
      api.zones(registry.account_id).each do |zone|
        api.dns_records(zone["id"]).each { |record| cnames[record["name"]] = record["content"] if record["type"] == "CNAME" }
      end
      shared.each do |host, tunnels|
        keep = tunnels.find { |tunnel| cnames[host] == tunnel.target } || tunnels.first
        (tunnels - [keep]).each { |tunnel| tunnel.routes.delete(host) }
        why = cnames[host] == keep.target ? "its DNS points there" : "no DNS points at any of them"
        @out.puts "! #{host} is routed on #{tunnels.map(&:name).join(' and ')}; kept on #{keep.name} (#{why}). " \
                  "./routes sync will drop it from the other#{tunnels.length > 2 ? 's' : ''}."
      end
    end

    # caddy: and note: exist only in routes.yml; keep them across a pull.
    def keep_local_fields(registry)
      return unless File.exist?(REGISTRY)

      old = begin
        Registry.load(REGISTRY)
      rescue Error => e
        @out.puts "! not keeping caddy:/note: from the current routes.yml: #{e.message}"
        return
      end
      old.tunnels.each_value do |old_tunnel|
        tunnel = registry.tunnels.each_value.find { |t| t.id == old_tunnel.id } or next
        tunnel.caddy = old_tunnel.caddy
        old_tunnel.routes.each do |host, old_route|
          route = tunnel.routes[host] or next
          route["caddy"] = old_route["caddy"] if old_route["caddy"] && old_route["service"] == route["service"]
          route["note"] = old_route["note"] if old_route["note"]
        end
      end
    end

    def list
      registry = Registry.load(REGISTRY)
      width = registry.tunnels.each_value.flat_map { |tunnel| tunnel.routes.keys }.map(&:length).max.to_i
      registry.tunnels.each_value do |tunnel|
        @out.puts "#{tunnel.name}#{tunnel.caddy ? ' (caddy)' : ''}#{tunnel.id == running_tunnel_id ? ' (this machine)' : ''}"
        tunnel.routes.each do |host, route|
          via = route["caddy"] ? "  -> caddy -> #{route['caddy']}" : ""
          @out.puts "  #{host.ljust(width)}  #{route['service']}#{via}"
        end
      end
    end

    def create(host, url, caddy:, tunnel:, dry_run:)
      host = Routes.normalize_host(host)
      url = Routes.normalize_url(url)
      registry = Registry.load(REGISTRY)
      owner = registry.owner(host)
      raise Error, "#{host} is already routed on #{owner.name}; use ./routes modify" if owner

      target = tunnel ? registry.tunnel(tunnel) : local_tunnel(registry)
      target.routes[host] = caddy ? { "service" => "http://localhost:#{caddy}", "caddy" => url } : { "service" => url }
      sync(registry, dry_run: dry_run, save: true)
    end

    # With caddy: in front, URL is the new upstream behind Caddy; otherwise it
    # is where Cloudflare points. --caddy PORT puts Caddy in front (or moves
    # it), --no-caddy takes it out, --tunnel moves the route to that tunnel.
    def modify(host, url, caddy:, no_caddy:, tunnel:, dry_run:)
      host = Routes.normalize_host(host)
      url = Routes.normalize_url(url)
      raise Error, "--caddy and --no-caddy together make no sense" if caddy && no_caddy

      registry = Registry.load(REGISTRY)
      owner = registry.owner(host) or raise Error, "#{host} is not in routes.yml; use ./routes create"
      route = owner.routes[host].dup
      if no_caddy
        route.delete("caddy")
        route["service"] = url
      elsif caddy
        route["service"] = "http://localhost:#{caddy}"
        route["caddy"] = url
      elsif route["caddy"]
        route["caddy"] = url
      else
        route["service"] = url
      end
      target = tunnel ? registry.tunnel(tunnel) : owner
      if target == owner
        owner.routes[host] = route
      else
        owner.routes.delete(host)
        target.routes[host] = route
      end
      sync(registry, dry_run: dry_run, save: true)
    end

    def delete(host, dry_run:)
      host = Routes.normalize_host(host)
      registry = Registry.load(REGISTRY)
      owner = registry.owner(host) or raise Error, "#{host} is not in routes.yml"
      owner.routes.delete(host)
      sync(registry, dry_run: dry_run, save: true)
    end

    def local_tunnel(registry)
      id = running_tunnel_id
      tunnel = id && registry.tunnels.each_value.find { |t| t.id == id }
      tunnel or raise Error, "no tunnel from routes.yml runs on this machine; pass --tunnel NAME (#{registry.tunnels.keys.join(', ')})"
    end

    # The tunnel id inside the --token of the cloudflared running on this
    # machine (base64 JSON: a = account, t = tunnel, s = secret), if any.
    def running_tunnel_id
      return @running_tunnel_id if defined?(@running_tunnel_id)

      token = `ps axww -o command= 2>/dev/null`[/cloudflared .*--token[ =](\S+)/, 1]
      @running_tunnel_id = token && JSON.parse(token.unpack1("m"))["t"]
    rescue JSON::ParserError, ArgumentError
      @running_tunnel_id = nil
    end

    # routes.yml is saved only once the plan has passed every check, so a
    # rejected change leaves it untouched.
    def sync(registry, dry_run:, save: false)
      syncer = Sync.new(registry: registry, api: api, caddyfile: CADDYFILE, reload: @reload,
                        local_tunnel_id: running_tunnel_id, out: @out)
      plan = syncer.plan
      syncer.print(plan)
      if dry_run
        @out.puts "(dry run: nothing changed)" unless plan.empty?
        return
      end
      if save
        registry.save(REGISTRY)
        saved = true
      end
      return if plan.empty?

      syncer.apply(plan)
      @out.puts "Done."
    rescue Error, SystemCallError, Net::OpenTimeout, Net::ReadTimeout, SocketError => e
      raise Error, "#{e.message}\nroutes.yml was saved; once fixed, run ./routes sync" if saved
      raise Error, e.message unless e.is_a?(Error)

      raise
    end
  end
end

if $PROGRAM_NAME == __FILE__
  begin
    exit Routes::CLI.new(ARGV).run
  rescue Routes::Error, OptionParser::ParseError => e
    warn "routes: #{e.message}"
    exit 1
  end
end
