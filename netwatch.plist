<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps ./netwatch running. Install:
     ln -sf ~/c/server/netwatch.plist ~/Library/LaunchAgents/me.chiq.netwatch.plist
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/me.chiq.netwatch.plist -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>me.chiq.netwatch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/grillermo/c/server/netwatch</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/grillermo/c/server/logs/netwatch.err.log</string>
</dict>
</plist>
