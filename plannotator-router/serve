#!/usr/bin/env bash
# (Re)start the Plannotator router in the "plannotator-router" tmux session, in
# place, and return. It owns port 19432 (Cloudflare route review.chiq.me, see
# ~/c/server/routes.yml) and serves each open review at /<id>/, forwarding to the
# review's own port. Reviews are opened with
# ~/c/agents-configs/bin/plannotator-review.sh, which registers each one under
# ~/.plannotator-router/<id>. Runs on the macmini; after-reboot.sh starts it.
set -euo pipefail
APP_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$APP_DIR"
SESSION=plannotator-router
# shellcheck source=/dev/null
. "$HOME/c/server/serve-in-place.sh"

PORT=19432

serve_pane router "$PORT" "python3 plannotator-router.py" /
serve_attach
