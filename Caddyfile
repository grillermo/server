# Auto Email Classifier
:3000 {
	# 1. Serve static assets 
	handle /Users/grillermo/c/auto-email-classifier/public/assets/* {
		file_server
	}

	# 2. Proxy everything else to your service on port 3000
	handle {
		reverse_proxy localhost:3001 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	log {
		output file /Users/grillermo/c/auto-email-classifier/logs/caddy_access.log {
			roll_size 100mb # Rotate when a log reaches 100MB
			roll_keep 10 # Keep a maximum of 10 log files
			roll_keep_for 7d # Keep logs for exactly 7 days
		}
	}
}

# readitsoon
:4000 {
	# 1. Serve static assets 
	handle /public/* {
		root * /Users/grillermo/c/readitsoon
		file_server
	}

	# 2. Proxy to blue (4001) or green (4003) — first healthy slot wins
	handle {
		reverse_proxy localhost:4001 localhost:4003 {
			lb_policy first
			fail_duration 5s
			lb_try_duration 8s

			# active health checking
			health_uri /health
			health_interval 10s
			health_timeout 3s
			health_status 200
			health_body `"ok":true`

			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	log {
		output file /Users/grillermo/c/readitsoon/log/caddy_access.log {
			roll_size 100mb # Rotate when a log reaches 100MB
			roll_keep 10 # Keep a maximum of 10 log files
			roll_keep_for 7d # Keep logs for exactly 7 days
		}
	}
}

# yosubee
:3200 {
	# 1. Define matcher for common scanner noise
	@blocked {
		path_regexp \.(php|aspx|asp|jsp|cgi)$
		path /wp-admin* /wp-login.php /admin.php /config.php /xmlrpc.php
	}

	# 2. Drop the noise immediately with a 404
	respond @blocked "Not Found" 404

	handle /public/* {
		root * /Users/grillermo/c/yosubee
		file_server
	}

	# Proxy to blue (3201) and green (3202) — balance across both
	handle {
		reverse_proxy localhost:3201 localhost:3202 {
			lb_policy round_robin
			fail_duration 5s
			lb_try_duration 8s

			# active health checking
			health_uri /health
			health_interval 10s
			health_timeout 3s
			health_status 200
			health_body `"ok":true`

			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	log {
		output file /Users/grillermo/c/yosubee/log/caddy_access.log {
			roll_size 100mb # Rotate when a log reaches 100MB
			roll_keep 10 # Keep a maximum of 10 log files
			roll_keep_for 7d # Keep logs for exactly 7 days
		}
	}
}

# patatatube — Caddy owns client-facing :3050, app runs on :3051.
# Static assets, packaged HLS segments and downloaded MP4s come straight off
# disk; API, SSR page, library streams and HLS packaging proxy to FastAPI.
#
# The token check for disk-served files happens *here*, not via forward_auth:
# every HLS segment used to cost a round trip to FastAPI /check-auth, so an
# iOS "Download all" turned thousands of 5ms disk reads into thousands of
# Python requests. UPLOAD_TOKEN reaches Caddy via `caddy run --envfile
# /Users/grillermo/c/patatatube/.env` (see homebrew.mxcl.caddy.plist).
:3050 {
	root * /Users/grillermo/c/patatatube

	# Same contract as the app's /check-auth: Bearer header for the iOS app,
	# ?token= for anything that cannot set headers, or the web page's login
	# cookie (set by POST /login). The cookie match is a substring test on the
	# whole Cookie header, so it only holds while UPLOAD_TOKEN stays free of
	# characters Starlette would quote — keep it [A-Za-z0-9._~-].
	@ptunauth {
		not header Authorization "Bearer {env.UPLOAD_TOKEN}"
		not query token={env.UPLOAD_TOKEN}
		not header Cookie *upload_token={env.UPLOAD_TOKEN}*
	}

	# 1. Static assets (unauthenticated; URL path == disk path)
	handle /assets/* {
		header Cache-Control "public, max-age=3600"
		log_append served_by caddy
		file_server
	}
	@rooticons path /favicon.ico /apple-touch-icon.png /apple-splash.png /apple-splash-optimized.jpg
	handle @rooticons {
		header Cache-Control "public, max-age=3600"
		log_append served_by caddy
		file_server
	}

	# 2. HLS assets: token check in-process, then serve the packaged file
	#    from data/hls/{id}/ if it exists; otherwise fall through to the app
	#    (which triggers packaging on master.m3u8 and answers 409/404).
	@hls path_regexp hls ^/videos/([0-9]+)/hls/(.+)$
	handle @hls {
		# MEDIA_ROOT/data/hls, matching paths.HLS_DIR; falls back to reverse_proxy
		# below when unset (root becomes the site root, so try_files just misses).
		root * {env.MEDIA_ROOT}
		route {
			respond @ptunauth 401
			@onDisk file {
				try_files /data/hls/{re.hls.1}/{re.hls.2}
			}
			rewrite @onDisk /data/hls/{re.hls.1}/{re.hls.2}
			# Go's mime table may not know these extensions; defer so the
			# override lands after file_server sets its own Content-Type
			@m3u8 path_regexp ^/data/hls/.+\.m3u8$
			header @m3u8 {
				Content-Type application/vnd.apple.mpegurl
				defer
			}
			@m4s path_regexp ^/data/hls/.+\.m4s$
			header @m4s {
				Content-Type video/iso.segment
				defer
			}
			@served path /data/hls/*
			header @served Cache-Control "public, max-age=31536000, immutable"
			log_append @served served_by caddy
			file_server @served
			reverse_proxy localhost:3051 {
				header_up Host {host}
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-For {remote_host}
				header_up X-Forwarded-Proto {scheme}
			}
		}
	}

	# 3. Downloaded/uploaded videos live at videos/{id}.mp4 — serve directly
	#    with Caddy's native Range/ETag support. Library videos (arbitrary
	#    source paths, version resolution) fall through to the app.
	@stream path_regexp stream ^/videos/([0-9]+)/stream$
	handle @stream {
		# MEDIA_ROOT/videos, matching paths.VIDEOS_DIR.
		root * {env.MEDIA_ROOT}
		route {
			respond @ptunauth 401
			@mp4 file {
				try_files /videos/{re.stream.1}.mp4
			}
			rewrite @mp4 /videos/{re.stream.1}.mp4
			@served path /videos/*.mp4
			header @served Cache-Control "public, max-age=31536000, immutable"
			log_append @served served_by caddy
			file_server @served
			reverse_proxy localhost:3051 {
				header_up Host {host}
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-For {remote_host}
				header_up X-Forwarded-Proto {scheme}
			}
		}
	}

	# 4. Everything else → FastAPI
	handle {
		reverse_proxy localhost:3051 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	log {
		output file /Users/grillermo/c/patatatube/log/caddy_access.log {
			roll_size 100mb # Rotate when a log reaches 100MB
			roll_keep 10 # Keep a maximum of 10 log files
			roll_keep_for 7d # Keep logs for exactly 7 days
		}
	}
}

# comunidad-antesis
:4020 {
	# Compress before the response leaves the box. Cloudflare fetches every
	# uncached HTML page from here, and this host's uplink (~107 Mbit) is far
	# narrower than its downlink, so origin egress is the scarce direction:
	# the landing page drops from ~4.2KB to ~1.4KB. zstd first, gzip as the
	# fallback for clients that do not advertise zstd.
	encode zstd gzip

	# public/ also holds build output and internal pages that must never leave
	# the box: the SSR bundle and its source map (vite-ssr), dev/test builds and
	# the QA checklist. Rails' static file server would hand them out too, so
	# refuse them here. A handle (not a bare respond) because Caddy orders every
	# handle before respond, and the catch-all proxy below would answer first.
	@private path /vite-ssr/* /vite-dev/* /vite-test/* /e2e-check.html
	handle @private {
		respond "Not Found" 404
	}

	# Content-hashed Vite build assets (…-BoY-d8R4.webp) — serve straight from
	# disk instead of through Puma. The hash makes each URL immutable, so the
	# browser fetches it once and reuses it for a year without revalidating.
	# bin/vite build writes them to public/vite/assets/, so root is public/.
	handle /vite/* {
		root * /Users/grillermo/c/comunidad-antesis/public
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Proxy to blue (4021) and green (4022) — balance across both
	handle {
		reverse_proxy localhost:4021 localhost:4022 {
			lb_policy round_robin
			fail_duration 5s
			lb_try_duration 8s

			# active health checking
			health_uri /health
			health_interval 10s
			health_timeout 3s
			health_status 200
			health_body `"status":"ok"`

			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	log {
		output file /Users/grillermo/c/comunidad-antesis//log/caddy_access.log {
			roll_size 100mb # Rotate when a log reaches 100MB
			roll_keep 10 # Keep a maximum of 10 log files
			roll_keep_for 7d # Keep logs for exactly 7 days
		}
	}
}

