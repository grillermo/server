#!/usr/bin/env ruby
# frozen_string_literal: true
#
# Which routes in routes.yml other machines can't open at http://<machine IP>:PORT,
# the URL the directory (http://192.168.1.1:81) links to.
#
#   ./lan-reach                  every tunnel except the one this machine runs
#   ./lan-reach --tunnel NAME    just that tunnel
#
# Run it from a machine on the LAN other than the one being checked: that is
# the path another machine's browser takes (firewall and bind address
# included). No sudo. The report also goes to logs/lan-reach-<host>.txt.
#
# Verdicts:
#   ok         answers (2xx, 3xx to the same address, 401 login, 404 no page at /)
#   REFUSED    connection refused: usually bound to 127.0.0.1, or nothing runs
#   TIMEOUT    no answer: firewall, or the machine is off
#   REDIRECT   sends the browser to another host (often https://its.domain)
#   ERROR      answers 403/5xx (502: Caddy is there but the app is down): often the app rejecting the IP as Host
#              (Rails config.hosts answers a bare 403, Vite allowedHosts, ...)
#   skip       not an HTTP route, or a machine with no known LAN IP

require "json"
require "open3"
require "socket"

load File.join(__dir__, "routes") # Routes::Registry, without running its CLI

Encoding.default_external = Encoding::UTF_8

# Tunnel name -> LAN IP of the machine that runs it (same as directory/main.go).
MACHINES = {
  "macmini-production" => "192.168.1.1",
  "macbookpro-development" => "192.168.1.2",
  "pc" => "192.168.1.3",
}.freeze

def running_tunnel_id
  out, = Open3.capture2e("ps", "axww", "-o", "command=")
  token = out[/cloudflared .*--token[ =](\S+)/, 1]
  token && JSON.parse(token.unpack1("m"))["t"]
rescue JSON::ParserError, ArgumentError, SystemCallError
  nil
end

# [curl exit code, status, location, title, host blocked?] of GET url, without following redirects.
def fetch(url)
  out, st = Open3.capture2e("curl", "-sS", "-m", "6", "--connect-timeout", "4", "-o", "-",
                            "-D", "/dev/stdout", "-w", "\n%{http_code}", url)
  status = out.lines.last.to_s.strip
  [st.exitstatus, status, out[/^location:\s*(\S+)/i, 1], out[%r{<title>\s*([^<]{1,80})}i, 1]&.strip,
   out.match?(/blocked host|not allowed host|invalid host header|allowedHosts/i)]
rescue SystemCallError
  [-1, "000", nil, nil, false]
end

registry = Routes::Registry.load(Routes::REGISTRY)
tunnels = if ARGV.include?("--tunnel")
            [registry.tunnel(ARGV[ARGV.index("--tunnel") + 1])]
          else
            own = running_tunnel_id
            registry.tunnels.values.reject { |t| t.id == own }
          end

host = Socket.gethostname.split(".").first
lines = ["lan-reach from #{host} at #{Time.now.strftime('%Y-%m-%d %H:%M:%S')}"]
counts = Hash.new(0)

tunnels.each do |tunnel|
  ip = MACHINES[tunnel.name]
  lines << "" << "== #{tunnel.name} (#{ip || 'no LAN IP known'})"
  tunnel.routes.each do |hostname, route|
    uri = URI(route["service"]) rescue nil
    unless ip && uri && %w[http https].include?(uri.scheme) && uri.port
      counts["skip"] += 1
      lines << format("%-9s %-42s %s", "skip", hostname, route["service"])
      next
    end
    url = "#{uri.scheme}://#{ip}:#{uri.port}/"
    code, status, location, title, blocked = fetch(url)
    title = "the app rejects this Host (blocked host)" if blocked || (status == "403" && title.nil?)
    target = location && (URI.join(url, location).host rescue nil)
    verdict = if code == 7 then "REFUSED"
              elsif code == 28 then "TIMEOUT"
              elsif status == "000" then "ERROR"
              elsif blocked then "ERROR"
              elsif status.start_with?("3") && target && target != ip then "REDIRECT"
              elsif status.to_i < 400 || %w[401 404].include?(status) then "ok" # 404: up, just no page at /
              else "ERROR"
              end
    counts[verdict] += 1
    detail = case verdict
             when "REFUSED", "TIMEOUT" then ""
             when "REDIRECT" then "#{status} -> #{location}"
             else [status, title].compact.join("  ")
             end
    lines << format("%-9s %-42s %-28s %s", verdict, hostname, url, detail).rstrip
  end
end

lines << "" << counts.sort.map { |verdict, n| "#{verdict} #{n}" }.join(", ")
report = lines.join("\n") + "\n"
puts report

dir = File.join(__dir__, "logs")
Dir.mkdir(dir) unless Dir.exist?(dir)
path = File.join(dir, "lan-reach-#{host}.txt")
File.write(path, report)
puts "Saved to #{path}"
